# ---- production node ----
# Where renders/uploads/stems/SQLite live
NEXUS_DATA_DIR=./backend/data
# Output resolution ceiling (1280 => 720x1280 vertical, 1920 => 1080x1920)
NEXUS_RENDER_MAX_DIM=1280
NEXUS_RENDER_FPS=30
NEXUS_RENDER_CRF=20
NEXUS_RENDER_PRESET=veryfast
# Hardware encode: auto | off
NEXUS_HWACCEL=auto
# Upload ceiling (MB) and target-duration ceiling (seconds)
NEXUS_MAX_UPLOAD_MB=512
NEXUS_MAX_TARGET_SEC=1800
# Remote ingestion (needs yt-dlp installed)
NEXUS_YTDLP=on
# Platforms break old clients constantly — keep yt-dlp current: pip install -U yt-dlp
# cookies.txt exported from a logged-in browser (needed for bot checks / private feeds)
# NEXUS_YTDLP_COOKIES=/data/cookies.txt
# Route downloads through a proxy when the node's IP is blocked
# NEXUS_YTDLP_PROXY=http://10.0.0.5:3128
# Override YouTube player clients, e.g. web_safari,tv
# NEXUS_YTDLP_CLIENTS=
# JS runtime used for signature solving (node is used automatically when deno is absent)
# NEXUS_YTDLP_JS_RUNTIME=node
# Explicit binaries if not on PATH
# NEXUS_FFMPEG=/usr/bin/ffmpeg
# NEXUS_FFPROBE=/usr/bin/ffprobe
# NEXUS_WATERMARK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---- optional hosted vision pass (gemini | openai | off) ----
NEXUS_VISION_PROVIDER=off
NEXUS_VISION_API_KEY=
# NEXUS_VISION_MODEL=gemini-2.5-pro

# ---- studio ----
NEXUS_BACKEND_URL=http://127.0.0.1:8000
# Max body the studio's /api proxy will forward (Next defaults to 10mb)
NEXUS_STUDIO_MAX_UPLOAD=512mb
NEXUS_STUDIO_PORT=3000
NEXUS_API_PORT=8000
